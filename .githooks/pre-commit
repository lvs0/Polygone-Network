#!/usr/bin/env bash
# SEC.8 — refuse un secret suivi avant qu'il n'entre dans un commit.
#
# Activation (une fois par clone) :
#   git config core.hooksPath .githooks
#
# Ce hook ne remplace pas `gitleaks`, absent de cette machine : il regarde ce
# que git SUIT, pas ce que l'historique contient déjà. Un secret déjà commité
# exige une rotation de clé, pas une réécriture d'historique.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
cargo test --quiet -p polygone-client --test no_tracked_secrets
